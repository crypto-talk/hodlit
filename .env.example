MYSQL_DATABASE=cryptalk
MYSQL_USER=cryptalk
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
# Base64-encoded 32-byte AES key. Required before connecting exchange API keys.
# Generate locally: openssl rand -base64 32
EXCHANGE_CREDENTIAL_ENCRYPTION_KEY=

# Comma-separated persisted member IDs allowed to manage news/polls. Empty denies all.
ADMIN_MEMBER_IDS=

# Frontend origin allowed to call this API. Do not include a trailing slash.
PUBLIC_ORIGIN=http://localhost

# Host port that exposes the backend API.
BACKEND_PORT=8080

# Enable this for real ETH balance verification.
ETHEREUM_RPC_URL=
# CoinGecko keyless public API by default. Override only for a compatible proxy.
MARKET_PRICE_BASE_URL=https://api.coingecko.com/api/v3

# Set true only when PUBLIC_ORIGIN uses HTTPS.
AUTH_COOKIE_SECURE=false

# Local/QA only. Exposes the browser API console under /test when true.
CRYPTALK_TEST_PAGES_ENABLED=false
# Reown Dashboard project ID for QR/mobile wallet connection in the test console.
WALLETCONNECT_PROJECT_ID=
